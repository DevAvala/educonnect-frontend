# Public origins only. Never put credentials or tokens in VITE_ variables.
# Staging example for preview review. Set the approved API explicitly for production.
VITE_API_BASE_URL=https://educonnect-backend-staging.onrender.com
VITE_SITE_URL=https://educonnect.com.ng
# Opt in only on the intended production website. Vercel previews always stay noindex.
VITE_ALLOW_INDEXING=false
# Vercel provides VERCEL_ENV automatically. Other hosts must set this to production
# before VITE_ALLOW_INDEXING=true has any effect.
VITE_DEPLOY_ENV=preview
